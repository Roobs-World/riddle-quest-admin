{
  "name": "@qwordly/core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic game domain logic for Qwordly",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./game": {
      "types": "./dist/game/index.d.ts",
      "default": "./dist/game/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "default": "./dist/bridge/index.js"
    },
    "./bridge/constants": {
      "types": "./dist/bridge/constants.d.ts",
      "default": "./dist/bridge/constants.js"
    },
    "./pricing": {
      "types": "./dist/pricing/index.d.ts",
      "default": "./dist/pricing/index.js"
    },
    "./pricing/catalog": {
      "types": "./dist/pricing/catalog.d.ts",
      "default": "./dist/pricing/catalog.js"
    },
    "./race": {
      "types": "./dist/race/index.d.ts",
      "default": "./dist/race/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "default": "./dist/validation/index.js"
    },
    "./validation/*": {
      "types": "./dist/validation/*.d.ts",
      "default": "./dist/validation/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "cross-env NODE_ENV=test jest --config jest.config.js",
    "test:race:coverage": "cross-env NODE_ENV=test jest --config jest.race-coverage.config.js --runInBand"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@types/jest": "30.0.0",
    "cross-env": "10.1.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
