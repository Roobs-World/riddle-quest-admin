{
  "name": "@qwordly/solo",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic self-contained solo play shared by the web Playable targets and the Android app",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "cross-env NODE_ENV=test jest --config jest.config.js",
    "test:coverage": "cross-env NODE_ENV=test jest --config jest.config.js --runInBand --coverage"
  },
  "dependencies": {
    "@qwordly/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "@types/react": "~19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "cross-env": "10.1.0",
    "jest": "30.5.2",
    "react": "19.3.0",
    "ts-jest": "29.4.14",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
