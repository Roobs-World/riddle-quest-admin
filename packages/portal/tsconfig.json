{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "stableTypeOrdering": true,
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["browser"],
    "paths": {
      "#platform-entry": ["./src/platform/PlatformEntry.tsx"],
      "#shop-modal-page": ["./src/play/modalPages/commerce/ShopModalPage.tsx"],
      "#youtube-content": ["../../firebase-functions/content/youtube-fixtures/youtube-content-fixture-v1.json"],
      "@qwordly/core": ["../core/src/index.ts"],
      "@qwordly/core/bridge": ["../core/src/bridge/index.ts"],
      "@qwordly/core/bridge/constants": ["../core/src/bridge/constants.ts"],
      "@qwordly/core/game": ["../core/src/game/index.ts"],
      "@qwordly/core/pricing/catalog": ["../core/src/pricing/catalog.ts"],
      "@qwordly/core/pricing/facebookCatalog": ["../core/src/pricing/facebookCatalog.ts"],
      "@qwordly/core/pricing/redditCatalog": ["../core/src/pricing/redditCatalog.ts"],
      "@qwordly/core/race": ["../core/src/race/index.ts"],
      "@qwordly/core/validation": ["../core/src/validation/index.ts"],
      "@qwordly/core/validation/*": ["../core/src/validation/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/**/__tests__/**", "src/test/**", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
