# Install this template outside the repository as an owner-only file:
# install -D -m 600 packages/portal/jest-release.credentials.example \
#   "${XDG_CONFIG_HOME:-$HOME/.config}/riddle-quest/jest-release.env"
JEST_GAME_UPLOAD_TOKEN=replace_with_your_jest_upload_token
JEST_NOTIFICATION_EMAIL=you@example.com
JEST_GAME_ID=019faa68-f3ec-755d-9ab5-c887fb426801

# Do not persist activation intent here. The canonical release fixes automatic
# activation in reviewed code and rejects JEST_UPLOAD_IS_ACTIVE and
# JEST_CONFIRM_ACTIVATION in this file and in the invoking environment.

# Optional private Sentry source-map upload. Use a dedicated token with only
# the release/project scopes needed by the Sentry Vite plugin.
SENTRY_UPLOAD_SOURCEMAPS=0
SENTRY_AUTH_TOKEN=sntrys_replace-with-dedicated-build-token
SENTRY_ORG=roobs-world-limited
SENTRY_PROJECT=riddle-quest
