# Copy to .env.jest-upload.local. The local file is ignored by Git.
JEST_GAME_UPLOAD_TOKEN=replace_with_your_jest_upload_token
JEST_NOTIFICATION_EMAIL=you@example.com
JEST_GAME_ID=019faa68-f3ec-755d-9ab5-c887fb426801
# Direct upload defaults to inactive. The timestamped one-click command always
# requests activation after successful processing while the game remains Draft.
JEST_UPLOAD_IS_ACTIVE=false
