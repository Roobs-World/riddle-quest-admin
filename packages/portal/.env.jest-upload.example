# Copy to .env.jest-upload.local. The local file is ignored by Git.
JEST_GAME_UPLOAD_TOKEN=replace_with_your_jest_upload_token
JEST_NOTIFICATION_EMAIL=you@example.com
JEST_GAME_ID=019faa68-f3ec-755d-9ab5-c887fb426801
# Every upload defaults to an inactive Draft version. Activation is intentionally
# a separate, explicit choice after the exact uploaded build has been verified.
JEST_UPLOAD_IS_ACTIVE=false
# To request activation, set JEST_UPLOAD_IS_ACTIVE=true and copy the exact game
# ID below. A mismatched or missing confirmation makes the upload fail closed.
JEST_CONFIRM_ACTIVATION=

# Optional private Sentry source-map upload. Create a dedicated organization
# token with only the release/project scopes needed by the Sentry Vite plugin.
# Store real values only in the ignored .env.jest-upload.local file.
SENTRY_UPLOAD_SOURCEMAPS=0
SENTRY_AUTH_TOKEN=sntrys_replace-with-dedicated-build-token
SENTRY_ORG=roobs-world-limited
SENTRY_PROJECT=riddle-quest
