{
  "name": "@riddle-quest/hosted",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral hosted play client shared by the Firebase-backed web targets and the Android app",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "cross-env NODE_ENV=test jest --config jest.config.js",
    "test:coverage": "cross-env NODE_ENV=test jest --config jest.config.js --runInBand --coverage"
  },
  "dependencies": {
    "@riddle-quest/core": "workspace:*"
  },
  "peerDependencies": {
    "firebase": "^12.19.0 || ^13.4.0"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "cross-env": "10.1.0",
    "firebase": "^13.4.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
