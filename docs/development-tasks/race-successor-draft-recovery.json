{
  "taskId": "multiplayer:race-successor-draft-recovery",
  "targets": [
    "jest",
    "facebook",
    "reddit",
    "youtube",
    "netflix",
    "yahoo",
    "gamesnacks"
  ],
  "work": "Preserve typing into the projected successor when a correct guess confirmation fails, and restore it only after an owned resume confirms the same question identity, position and length; merge authoritative hints and invalidate the private candidate on fresh intent or account changes.",
  "remainingGates": [
    "Remaining multiplayer architecture requirements have independent development checks.",
    "Provider submission, approval and deployment require their own receipts."
  ],
  "nextAction": "Continue the remaining multiplayer requirements and accepted-revision release verification.",
  "checks": [
    {
      "id": "race-transitions",
      "executable": "pnpm",
      "args": [
        "--filter",
        "@qwordly/portal",
        "test",
        "--runInBand",
        "--testPathPatterns=src/play/race/__tests__"
      ]
    },
    {
      "id": "portal-types",
      "executable": "pnpm",
      "args": [
        "--filter",
        "@qwordly/portal",
        "check:types"
      ]
    },
    {
      "id": "isolated-target-builds",
      "executable": "pnpm",
      "args": [
        "--filter",
        "@qwordly/portal",
        "build:all-targets"
      ]
    },
    {
      "id": "injected-successor-draft-recovery",
      "executable": "env",
      "args": [
        "PORTAL_BROWSER_TESTS=1",
        "PORTAL_USE_EXISTING_BUILD=1",
        "pnpm",
        "--filter",
        "@qwordly/portal",
        "test",
        "--runInBand",
        "--runTestsByPath",
        "src/jest/__tests__/authentication.jest-playwright.test.ts",
        "--testNamePattern=restores successor typing after|rejects inconsistent hint confirmations|preserves solving time when hint and skip|recovers a completely lost hint response"
      ]
    },
    {
      "id": "artifact-dependency-evidence",
      "executable": "node",
      "args": [
        "scripts/release/verify-target-dependency-evidence.mjs"
      ]
    },
    {
      "id": "maintainable-file-sizes",
      "executable": "pnpm",
      "args": [
        "check:file-sizes"
      ]
    }
  ],
  "artifacts": [
    {
      "target": "jest",
      "file": "artifacts/target-dependencies/jest.json"
    },
    {
      "target": "facebook",
      "file": "artifacts/target-dependencies/facebook.json"
    },
    {
      "target": "reddit",
      "file": "artifacts/target-dependencies/reddit.json"
    },
    {
      "target": "youtube",
      "file": "artifacts/target-dependencies/youtube.json"
    },
    {
      "target": "netflix",
      "file": "artifacts/target-dependencies/netflix.json"
    },
    {
      "target": "yahoo",
      "file": "artifacts/target-dependencies/yahoo.json"
    },
    {
      "target": "gamesnacks",
      "file": "artifacts/target-dependencies/gamesnacks.json"
    }
  ]
}
