{
  "taskId": "multiplayer:race-projection-recovery",
  "targets": [
    "jest",
    "facebook",
    "reddit",
    "youtube",
    "netflix",
    "yahoo",
    "gamesnacks"
  ],
  "work": "Preserve solving time through hint/skip projection and rollback; reject confirmations for another run; invalidate stale receipts on teardown and category navigation; align injected quit behaviour with prepared/scheduled runs; replay cumulative opponent progress including skips; load matchmaking response validation on demand to keep startup within the artifact budget; normalize backend/provider errors to translated recoverable messages.",
  "remainingGates": [
    "Remaining multiplayer architecture requirements have independent development checks.",
    "Provider submission, approval and deployment require their own receipts."
  ],
  "nextAction": "Review the projection recovery changes and continue the remaining multiplayer architecture work.",
  "checks": [
    {
      "id": "race-transitions",
      "executable": "pnpm",
      "args": [
        "--filter",
        "@qwordly/portal",
        "test",
        "--runInBand",
        "--testPathPatterns=src/play/race/__tests__"
      ]
    },
    {
      "id": "matchmaking-validation",
      "executable": "pnpm",
      "args": [
        "--filter",
        "@qwordly/portal",
        "test",
        "--runInBand",
        "--runTestsByPath",
        "src/play/__tests__/firebaseRaceMatchmaking.test.ts"
      ]
    },
    {
      "id": "portal-types",
      "executable": "pnpm",
      "args": [
        "--filter",
        "@qwordly/portal",
        "check:types"
      ]
    },
    {
      "id": "isolated-target-builds",
      "executable": "pnpm",
      "args": [
        "--filter",
        "@qwordly/portal",
        "build:all-targets"
      ]
    },
    {
      "id": "injected-race-flows",
      "executable": "env",
      "args": [
        "PORTAL_BROWSER_TESTS=1",
        "PORTAL_USE_EXISTING_BUILD=1",
        "pnpm",
        "--filter",
        "@qwordly/portal",
        "test",
        "--runInBand",
        "--runTestsByPath",
        "src/jest/__tests__/retainedRaceRecovery.jest-playwright.test.ts",
        "src/jest/__tests__/retainedRaceQuit.jest-playwright.test.ts",
        "--testNamePattern=renders the preloaded next riddle|shows an opponent win immediately|shows a completed creator result|recovers a guess rejected|keeps the immediate result visible|acknowledges close during|confirms quitting an active race|preserves solving time when hint|replays an opponent skip milestone"
      ]
    },
    {
      "id": "artifact-dependency-evidence",
      "executable": "node",
      "args": [
        "scripts/release/verify-target-dependency-evidence.mjs"
      ]
    }
  ],
  "artifacts": [
    {
      "target": "jest",
      "file": "artifacts/target-dependencies/jest.json",
      "checkId": "isolated-target-builds"
    },
    {
      "target": "facebook",
      "file": "artifacts/target-dependencies/facebook.json",
      "checkId": "isolated-target-builds"
    },
    {
      "target": "reddit",
      "file": "artifacts/target-dependencies/reddit.json",
      "checkId": "isolated-target-builds"
    },
    {
      "target": "youtube",
      "file": "artifacts/target-dependencies/youtube.json",
      "checkId": "isolated-target-builds"
    },
    {
      "target": "netflix",
      "file": "artifacts/target-dependencies/netflix.json",
      "checkId": "isolated-target-builds"
    },
    {
      "target": "yahoo",
      "file": "artifacts/target-dependencies/yahoo.json",
      "checkId": "isolated-target-builds"
    },
    {
      "target": "gamesnacks",
      "file": "artifacts/target-dependencies/gamesnacks.json",
      "checkId": "isolated-target-builds"
    }
  ]
}
