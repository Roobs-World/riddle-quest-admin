{
  "taskId": "multiplayer:race-delivery-timeout-recovery",
  "targets": [
    "jest",
    "facebook",
    "reddit",
    "youtube",
    "netflix",
    "yahoo",
    "gamesnacks"
  ],
  "work": "Bound lost multiplayer bridge responses to 30 seconds, release pending controls and projection loaders through existing correlated failure recovery, preserve original mutation receipts for preparation/quit/publication and ignore late responses during newer recovery.",
  "remainingGates": [
    "Remaining multiplayer architecture requirements have independent development checks.",
    "Provider submission, approval and deployment require their own receipts."
  ],
  "nextAction": "Continue the remaining multiplayer requirements and accepted-revision release verification.",
  "checks": [
    {
      "id": "race-transitions",
      "executable": "pnpm",
      "args": [
        "--filter",
        "@qwordly/portal",
        "test",
        "--runInBand",
        "--testPathPatterns=src/play/race/__tests__"
      ]
    },
    {
      "id": "portal-types",
      "executable": "pnpm",
      "args": [
        "--filter",
        "@qwordly/portal",
        "check:types"
      ]
    },
    {
      "id": "isolated-target-builds",
      "executable": "pnpm",
      "args": [
        "--filter",
        "@qwordly/portal",
        "build:all-targets"
      ]
    },
    {
      "id": "injected-delivery-timeout-recovery",
      "executable": "env",
      "args": [
        "PORTAL_BROWSER_TESTS=1",
        "PORTAL_USE_EXISTING_BUILD=1",
        "pnpm",
        "--filter",
        "@qwordly/portal",
        "test",
        "--runInBand",
        "--runTestsByPath",
        "src/jest/__tests__/retainedRaceRecovery.jest-playwright.test.ts",
        "src/jest/__tests__/retainedRaceQuit.jest-playwright.test.ts",
        "--testNamePattern=recovers a completely lost hint response|rejects inconsistent hint confirmations|recovers rejected race preparation|recovers lost quit confirmations|recovers lost publication confirmations"
      ]
    },
    {
      "id": "artifact-dependency-evidence",
      "executable": "node",
      "args": [
        "scripts/release/verify-target-dependency-evidence.mjs"
      ]
    },
    {
      "id": "maintainable-file-sizes",
      "executable": "pnpm",
      "args": [
        "check:file-sizes"
      ]
    }
  ],
  "artifacts": [
    {
      "target": "jest",
      "file": "artifacts/target-dependencies/jest.json",
      "checkId": "isolated-target-builds"
    },
    {
      "target": "facebook",
      "file": "artifacts/target-dependencies/facebook.json",
      "checkId": "isolated-target-builds"
    },
    {
      "target": "reddit",
      "file": "artifacts/target-dependencies/reddit.json",
      "checkId": "isolated-target-builds"
    },
    {
      "target": "youtube",
      "file": "artifacts/target-dependencies/youtube.json",
      "checkId": "isolated-target-builds"
    },
    {
      "target": "netflix",
      "file": "artifacts/target-dependencies/netflix.json",
      "checkId": "isolated-target-builds"
    },
    {
      "target": "yahoo",
      "file": "artifacts/target-dependencies/yahoo.json",
      "checkId": "isolated-target-builds"
    },
    {
      "target": "gamesnacks",
      "file": "artifacts/target-dependencies/gamesnacks.json",
      "checkId": "isolated-target-builds"
    }
  ]
}
