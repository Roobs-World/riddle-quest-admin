{
  "name": "riddle-quest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @qwordly/portal dev",
    "dev": "pnpm --filter @qwordly/portal dev",
    "build": "pnpm --filter @qwordly/core build && pnpm --filter @qwordly/portal build:jest && pnpm --dir firebase-functions build",
    "build:web": "pnpm --filter @qwordly/portal build:jest",
    "test": "pnpm --filter @qwordly/core test && pnpm --filter @qwordly/portal test",
    "test:web": "pnpm --filter @qwordly/portal test",
    "test:core": "pnpm --filter @qwordly/core test",
    "test:functions": "pnpm --dir firebase-functions test",
    "jest:build-upload": "pnpm --filter @qwordly/portal release:jest:timestamped"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "packageManager": "pnpm@11.18.0"
}
