{
  "name": "riddle-quest",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "pnpm exec expo start --dev-client",
    "fix:inotify": "bash scripts/fix-inotify-linux.sh",
    "check:inotify": "bash scripts/fix-inotify-linux.sh --check",
    "start:android:emulator": "cross-env REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 EXPO_PACKAGER_PROXY_URL=http://127.0.0.1:8081 pnpm exec expo start --dev-client --host localhost --port 8081 --clear",
    "start:android:emulator:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-android-dev-client.ps1",
    "start:debug": "cross-env EXPO_DEBUG=true pnpm exec expo start --dev-client --clear --port 8081",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-android-device.ps1",
    "android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-android-device.ps1 -DebugCli",
    "android:assemble:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-emulator-compat.ps1 -Build -TimeoutSeconds 600",
    "qa:android:compat": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-emulator-compat.ps1",
    "qa:android:emulators": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-emulator-health.ps1 -CleanLocks -TimeoutSeconds 300",
    "ios": "pnpm exec expo run:ios",
    "web": "pnpm exec expo start --web",
    "portal": "pnpm --filter @qwordly/portal dev",
    "portal:build": "pnpm --filter @qwordly/portal build",
    "portal:deploy": "pnpm run portal:build && firebase deploy --only hosting",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js --ext .jsx --ext .ts --ext .tsx --fix",
    "test": "cross-env NODE_ENV=test jest",
    "test:rn": "cross-env NODE_ENV=test jest --testPathPatterns=src",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:coverage:game": "node scripts/check-game-coverage.js",
    "test:coverage:project": "node scripts/check-project-coverage.js",
    "setup:tests": "pnpm run test:setup:all",
    "test:setup:all": "pnpm install --frozen-lockfile && pnpm exec expo prebuild --platform android",
    "test:android:matrix": "pnpm run test:android:matrix:coverage && pnpm run test:android:matrix:unit && pnpm run android:assemble:emulator && pnpm run qa:android:emulators && pnpm run test:android:matrix:run",
    "test:android:matrix:coverage": "node scripts/verify-android-matrix-coverage.js --verify",
    "test:android:matrix:unit": "cross-env NODE_ENV=test jest --testPathPatterns=src --runInBand",
    "test:android:matrix:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-emulator-run-matrix.ps1",
    "test:ios:browserstack": "wdio run test/browserstack/wdio.ios.conf.mjs",
    "test:ios:browserstack:config": "node test/browserstack/validate-ios-config.mjs",
    "test:ios:browserstack:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-ios-browserstack.ps1",
    "perf:bundle-smoke": "node scripts/check-bundle-size.js",
    "check:no-any": "node scripts/check-no-any.js",
    "test:precommit": "node scripts/pre-commit.js",
    "check:rn-upgrade": "node scripts/check-rn-upgrade.js",
    "i18n:generate": "node scripts/generate-i18n.js",
    "i18n:check": "node scripts/generate-i18n.js",
    "i18n:quality": "node scripts/check-i18n-quality.js --strict",
    "i18n:legacy-check": "node scripts/check-legacy-i18n-usage.js",
    "hardcoded-text:check": "node scripts/check-hardcoded-text.js",
    "i18n:verify": "pnpm run i18n:generate && pnpm run i18n:quality && pnpm run hardcoded-text:check && pnpm run i18n:legacy-check",
    "baseline:report": "node scripts/baseline-report.js",
    "validate:upgrade": "pnpm run check:rn-upgrade && pnpm run lint && pnpm run test:rn --runInBand",
    "test:core": "pnpm --filter @qwordly/core test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@qwordly/core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/analytics": "^24.1.1",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/app-check": "^24.1.1",
    "@react-native-firebase/auth": "^24.1.1",
    "@react-native-firebase/crashlytics": "^24.1.1",
    "@react-native-firebase/firestore": "^24.1.1",
    "@react-native-firebase/functions": "^24.1.1",
    "@react-native-firebase/storage": "^24.1.1",
    "@react-native-google-signin/google-signin": "16.1.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "@react-three/fiber": "^9.6.1",
    "@sentry/core": "^10.62.0",
    "@sentry/react-native": "~8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo": "56.0.12",
    "expo-asset": "56.0.17",
    "expo-audio": "56.0.12",
    "expo-constants": "56.0.18",
    "expo-font": "56.0.7",
    "expo-gl": "~56.0.5",
    "expo-haptics": "56.0.3",
    "expo-modules-core": "~56.0.17",
    "firebase-functions": "^7.2.5",
    "googleapis": "^171.4.0",
    "metro": "^0.84.4",
    "openai": "^6.45.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css-interop": "0.2.6",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-iap": "^15.3.4",
    "react-native-image-picker": "^8.2.1",
    "react-native-nitro-modules": "0.35.10",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "tailwindcss": "^3.4.19",
    "three": "0.182.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@react-native-community/cli": "latest",
    "@react-native/jest-preset": "0.85.3",
    "@react-three/eslint-plugin": "^0.1.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "^25.9.4",
    "@types/prop-types": "^15.7.15",
    "@types/react": "~19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "@types/three": "0.182.0",
    "@wdio/browserstack-service": "9.29.1",
    "@wdio/cli": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "babel-jest": "30.4.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^10.1.0",
    "expo-build-properties": "56.0.19",
    "fallow": "2.103.0",
    "firebase-admin": "^13.10.0",
    "husky": "^9.1.7",
    "jest": "~30.4.2",
    "jest-expo": "56.0.5",
    "nativewind": "^4.2.6",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "@react-native/jest-preset",
        "jest",
        "@types/jest"
      ]
    },
    "autolinking": {
      "exclude": []
    }
  },
  "packageManager": "pnpm@11.8.0+sha1.d1cb3c2c0c77584011fece2f27384b37788fb7ca"
}
