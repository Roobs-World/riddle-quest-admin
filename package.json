{
  "name": "riddle-quest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "audit:facebook-artifact": "node platforms/web/facebook/scripts/audit-facebook-artifact.mjs",
    "audit:jest-artifact": "node platforms/web/jest/scripts/audit-jest-artifact.mjs",
    "audit:netflix-artifact": "node scripts/web/audit-standalone-artifact.mjs netflix",
    "audit:reddit-artifact": "node platforms/web/reddit/scripts/audit-reddit-artifact.mjs",
    "audit:yahoo-artifact": "node scripts/web/audit-standalone-artifact.mjs yahoo",
    "audit:youtube-artifact": "node platforms/web/youtube/scripts/audit-youtube-artifact.mjs",
    "build": "pnpm prepare:functions && pnpm build:web && pnpm --dir firebase-functions build",
    "build:all-targets": "pnpm build:web && pnpm build:youtube && pnpm build:netflix && pnpm build:yahoo && pnpm build:gamesnacks",
    "build:facebook": "pnpm check:target-boundaries && pnpm check:facebook-commerce-activation && pnpm check:locales && pnpm check:licenses && NODE_ENV=production tsc -b && FACEBOOK_BUILD=1 NODE_ENV=production vite build --mode facebook && pnpm audit:facebook-artifact",
    "build:gamesnacks": "pnpm check:target-boundaries && pnpm check:youtube-content:release && pnpm check:locales && NODE_ENV=production tsc -b && GAMESNACKS_BUILD=1 NODE_ENV=production vite build --mode gamesnacks && node platforms/web/gamesnacks/scripts/package-gamesnacks.mjs",
    "build:jest": "pnpm check:target-boundaries && pnpm check:locales && pnpm check:licenses && pnpm check:jest-console && NODE_ENV=production tsc -b && JEST_BUILD=1 VITE_JEST_RUNTIME=1 NODE_ENV=production vite build --mode jest && pnpm audit:jest-artifact",
    "build:jest-facebook": "pnpm prepare:functions && pnpm build:jest && pnpm build:facebook",
    "build:netflix": "pnpm check:target-boundaries && pnpm check:youtube-content:release && pnpm check:locales && NODE_ENV=production tsc -b && NETFLIX_BUILD=1 NODE_ENV=production vite build --mode netflix && pnpm audit:netflix-artifact",
    "build:notification-manager": "pnpm --filter @riddle-quest/notification-manager build",
    "build:reddit": "pnpm --filter @riddle-quest/reddit-app build:package",
    "build:reddit:client": "pnpm check:target-boundaries && pnpm check:locales && pnpm check:licenses && NODE_ENV=production tsc -b && REDDIT_BUILD=1 NODE_ENV=production vite build --mode reddit && pnpm audit:reddit-artifact",
    "build:shared": "pnpm --dir firebase-functions build",
    "build:web": "pnpm build:jest && pnpm build:facebook && pnpm build:reddit:client && pnpm --filter @riddle-quest/reddit-app build:package:from-client",
    "build:yahoo": "pnpm check:target-boundaries && pnpm check:youtube-content:release && pnpm check:locales && NODE_ENV=production tsc -b && YAHOO_BUILD=1 NODE_ENV=production vite build --mode yahoo && pnpm audit:yahoo-artifact",
    "build:youtube": "pnpm check:target-boundaries && pnpm check:youtube-content:release && pnpm check:locales && NODE_ENV=production tsc -b && YOUTUBE_BUILD=1 NODE_ENV=production vite build --mode youtube && pnpm audit:youtube-artifact",
    "check:braces-security": "node scripts/audit-braces-security.mjs",
    "check:facebook-commerce-activation": "node platforms/web/facebook/scripts/audit-facebook-commerce-activation.mjs",
    "check:facebook-copy": "node platforms/web/facebook/scripts/audit-facebook-visible-copy.mjs",
    "check:facebook-profile-boundary": "node platforms/web/facebook/scripts/audit-facebook-profile-boundary.mjs",
    "check:facebook-progress": "node platforms/web/facebook/scripts/validate-facebook-progress.mjs",
    "check:facebook-secrets": "node platforms/web/facebook/scripts/audit-facebook-secret-boundary.mjs",
    "check:file-sizes": "node scripts/audit-file-sizes.mjs",
    "check:functions-layout": "node firebase-functions/scripts/build/audit-directory-layout.js",
    "check:functions-lock": "npm --prefix firebase-functions ci --dry-run --ignore-scripts --omit=dev --no-audit --no-fund --silent",
    "check:jest-console": "node platforms/web/jest/scripts/validate-jest-console-manifest.mjs",
    "check:jest-console:release": "node platforms/web/jest/scripts/validate-jest-console-manifest.mjs --release-ready",
    "check:licenses": "node scripts/web/generate-third-party-licenses.mjs --check",
    "check:locales": "node scripts/web/audit-locales.mjs",
    "check:modern-packages": "node scripts/audit-modern-package-features.mjs",
    "check:monetization": "node scripts/audit-platform-monetization.mjs",
    "check:platform-layout": "node scripts/audit-platform-layout.mjs",
    "check:reddit-docs": "node platforms/web/reddit/scripts/audit-reddit-documentation.mjs",
    "check:reddit-setup": "bash -n platforms/web/reddit/scripts/setup-reddit-games.sh",
    "check:scalability": "node scripts/audit-function-capacity.mjs && node scripts/audit-backend-scalability.mjs",
    "check:security": "pnpm check:braces-security && node scripts/audit-security-config.mjs && node scripts/ci-security.mjs",
    "check:target-boundaries": "node scripts/audit-platform-layout.mjs && node scripts/web/audit-web-target-boundaries.mjs",
    "check:tsdoc": "node scripts/audit-tsdoc.mjs",
    "check:types": "pnpm check:platform-layout && pnpm check:types:shared && pnpm --filter @riddle-quest/android check:types && pnpm --dir firebase-functions check:types && pnpm --filter @riddle-quest/reddit-app check:types && pnpm check:types:notification-manager",
    "check:types:jest-facebook": "pnpm check:platform-layout && pnpm check:types:shared",
    "check:types:notification-manager": "pnpm --filter @riddle-quest/notification-manager check:types",
    "check:types:shared": "tsc -p tsconfig.json --noEmit",
    "check:w3c": "pnpm validate:w3c",
    "check:youtube-content:release": "pnpm --dir firebase-functions youtube:content:audit",
    "check:youtube-progress": "node platforms/web/youtube/scripts/validate-youtube-playables-progress.mjs",
    "evidence:youtube": "node platforms/web/youtube/scripts/youtube-release-artifact-evidence.mjs",
    "facebook:draft": "node platforms/web/facebook/scripts/facebook-draft-evidence.mjs",
    "facebook:preflight": "pnpm preflight:facebook-upload",
    "facebook:setup": "bash platforms/web/facebook/scripts/setup-facebook-instant-games.sh",
    "jest:build-upload": "pnpm release:jest",
    "licenses:generate": "node scripts/web/generate-third-party-licenses.mjs --write",
    "migrate:game-builds": "node scripts/web/migrate-game-build-outputs.mjs",
    "package:youtube": "node platforms/web/youtube/scripts/youtube-release-artifact.mjs",
    "preflight:all-platforms": "pnpm verify:all-targets && pnpm release:plan",
    "preflight:facebook-backend": "pnpm check:facebook-secrets && pnpm --dir firebase-functions preflight:facebook-backend",
    "preflight:facebook-upload": "pnpm build:facebook && node platforms/web/facebook/scripts/prepare-facebook-draft.mjs",
    "preflight:jest-upload": "JEST_UPLOAD_DRY_RUN=true node platforms/web/jest/scripts/upload-jest-build.mjs",
    "preflight:reddit-promotion": "node platforms/web/reddit/scripts/assert-reddit-promotion-ready.mjs",
    "preflight:youtube-upload": "node platforms/web/youtube/scripts/youtube-release-artifact-evidence.mjs && node platforms/web/youtube/scripts/youtube-release-artifact.mjs",
    "prepare:functions": "pnpm --dir firebase-functions prepare:deploy",
    "prepare:html5-handoffs": "node scripts/release/package-html5-release.mjs",
    "release:addictinggames": "node scripts/release/run-platform-release.mjs addictinggames",
    "release:airconsole": "node scripts/release/run-platform-release.mjs airconsole",
    "release:all": "node scripts/release/run-platform-release.mjs all",
    "release:amazon": "node scripts/release/run-platform-release.mjs amazon",
    "release:armor": "node scripts/release/run-platform-release.mjs armor",
    "release:coolmath": "node scripts/release/run-platform-release.mjs coolmath",
    "release:crazygames": "node scripts/release/run-platform-release.mjs crazygames",
    "release:facebook": "node scripts/release/run-platform-release.mjs facebook",
    "release:facebook:handoff": "pnpm preflight:facebook-upload && pnpm facebook:draft begin",
    "release:famobi": "node scripts/release/run-platform-release.mjs famobi",
    "release:farcaster": "node scripts/release/run-platform-release.mjs farcaster",
    "release:gamedistribution": "node scripts/release/run-platform-release.mjs gamedistribution",
    "release:gameflare": "node scripts/release/run-platform-release.mjs gameflare",
    "release:gamejolt": "node scripts/release/run-platform-release.mjs gamejolt",
    "release:gamemonetize": "node scripts/release/run-platform-release.mjs gamemonetize",
    "release:gamepix": "node scripts/release/run-platform-release.mjs gamepix",
    "release:gamepush": "node scripts/release/run-platform-release.mjs gamepush",
    "release:gamesnacks": "node scripts/release/run-platform-release.mjs gamesnacks",
    "release:greenhouse": "node scripts/release/run-platform-release.mjs greenhouse",
    "release:htmlgames": "node scripts/release/run-platform-release.mjs htmlgames",
    "release:huawei": "node scripts/release/run-platform-release.mjs huawei",
    "release:itch": "node scripts/release/run-platform-release.mjs itch",
    "release:jest": "node scripts/release/run-platform-release.mjs jest",
    "release:jest:timestamped": "node platforms/web/jest/scripts/release-jest-timestamped.mjs",
    "release:jiogames": "node scripts/release/run-platform-release.mjs jiogames",
    "release:kizi": "node scripts/release/run-platform-release.mjs kizi",
    "release:kongregate": "node scripts/release/run-platform-release.mjs kongregate",
    "release:lagged": "node scripts/release/run-platform-release.mjs lagged",
    "release:minipay": "node scripts/release/run-platform-release.mjs minipay",
    "release:miniplay": "node scripts/release/run-platform-release.mjs miniplay",
    "release:miro": "node scripts/release/run-platform-release.mjs miro",
    "release:netflix": "node scripts/release/run-platform-release.mjs netflix",
    "release:newgrounds": "node scripts/release/run-platform-release.mjs newgrounds",
    "release:noadsgames": "node scripts/release/run-platform-release.mjs noadsgames",
    "release:ozogames": "node scripts/release/run-platform-release.mjs ozogames",
    "release:pi": "node scripts/release/run-platform-release.mjs pi",
    "release:plan": "node scripts/release/run-platform-release.mjs --list",
    "release:playgama": "node scripts/release/run-platform-release.mjs playgama",
    "release:playkovo": "node scripts/release/run-platform-release.mjs playkovo",
    "release:rando": "node scripts/release/run-platform-release.mjs rando",
    "release:reddit": "node scripts/release/run-platform-release.mjs reddit",
    "release:shockwave": "node scripts/release/run-platform-release.mjs shockwave",
    "release:slowden": "node scripts/release/run-platform-release.mjs slowden",
    "release:softgames": "node scripts/release/run-platform-release.mjs softgames",
    "release:telegram": "node scripts/release/run-platform-release.mjs telegram",
    "release:wgplayground": "node scripts/release/run-platform-release.mjs wgplayground",
    "release:world": "node scripts/release/run-platform-release.mjs world",
    "release:y8": "node scripts/release/run-platform-release.mjs y8",
    "release:yahoo": "node scripts/release/run-platform-release.mjs yahoo",
    "release:yalgames": "node scripts/release/run-platform-release.mjs yalgames",
    "release:yandex": "node scripts/release/run-platform-release.mjs yandex",
    "release:youtube": "node scripts/release/run-platform-release.mjs youtube",
    "release:zoom": "node scripts/release/run-platform-release.mjs zoom",
    "validate:w3c": "node scripts/web/validate-w3c.mjs",
    "verify:all-targets": "pnpm check:security && pnpm build:all-targets",
    "verify:functions:node22": "pnpm prepare:functions && node firebase-functions/scripts/runtime/run-with-functions-node.js firebase-functions/scripts/runtime/verify-node-runtime.js",
    "verify:production": "pnpm check:braces-security && pnpm audit --prod --audit-level high && pnpm audit --audit-level high && pnpm check:monetization && pnpm check:functions-lock && pnpm check:facebook-secrets && pnpm check:youtube-progress && pnpm check:types && pnpm --dir firebase-functions lint && pnpm verify:functions:node22 && pnpm check:facebook-copy && pnpm build && pnpm check:w3c && pnpm preflight:jest-upload",
    "youtube:evidence": "pnpm evidence:youtube",
    "youtube:package": "pnpm package:youtube",
    "youtube:preflight": "pnpm release:youtube"
