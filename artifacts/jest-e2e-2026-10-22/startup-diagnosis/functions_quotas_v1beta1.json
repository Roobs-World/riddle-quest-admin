[
  {
    "metric": "cloudfunctions.googleapis.com/build_time",
    "displayName": "Functions build time in seconds",
    "limits": [
      {
        "metric": "cloudfunctions.googleapis.com/build_time",
        "unit": "1/d/{project}",
        "buckets": [
          {
            "effectiveLimit": "300000",
            "defaultLimit": "300000"
          }
        ]
      }
    ]
  },
  {
    "metric": "cloudfunctions.googleapis.com/cpu_allocation",
    "displayName": "Total CPU allocation",
    "limits": [
      {
        "metric": "cloudfunctions.googleapis.com/cpu_allocation",
        "unit": "1/min/{project}/{region}",
        "buckets": [
          {
            "effectiveLimit": "200000",
            "defaultLimit": "200000"
          },
          {
            "dimensions": {
              "region": "us-central1"
            },
            "effectiveLimit": "200000",
            "defaultLimit": "200000"
          }
        ]
      }
    ]
  },
  {
    "metric": "cloudfunctions.googleapis.com/mem_allocation",
    "displayName": "Total memory allocation",
    "limits": [
      {
        "metric": "cloudfunctions.googleapis.com/mem_allocation",
        "unit": "1/min/{project}/{region}",
        "buckets": [
          {
            "effectiveLimit": "429496729600",
            "defaultLimit": "429496729600"
          },
          {
            "dimensions": {
              "region": "us-central1"
            },
            "effectiveLimit": "429496729600",
            "defaultLimit": "429496729600"
          }
        ]
      }
    ]
  },
  {
    "metric": "cloudfunctions.googleapis.com/read_requests",
    "displayName": "Read requests to Cloud Functions Admin API",
    "limits": [
      {
        "metric": "cloudfunctions.googleapis.com/read_requests",
        "unit": "1/min/{project}",
        "buckets": [
          {
            "effectiveLimit": "3000",
            "defaultLimit": "3000"
          }
        ]
      }
    ]
  },
  {
    "metric": "cloudfunctions.googleapis.com/test_call_requests",
