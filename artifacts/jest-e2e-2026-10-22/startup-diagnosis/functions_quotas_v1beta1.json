      {
        "metric": "cloudfunctions.googleapis.com/test_call_requests",
        "unit": "1/min/{project}",
        "buckets": [
          {
            "effectiveLimit": "10",
            "defaultLimit": "10"
          }
        ]
      }
    ]
  },
