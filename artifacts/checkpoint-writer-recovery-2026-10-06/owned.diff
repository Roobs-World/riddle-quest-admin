+import {build} from 'vite';
+import {chromium, firefox} from '@playwright/test';
+
+const portal = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const mode = process.env.CHECKPOINT_WRITER_REACT_MODE ?? 'development';
