+import {parseGameToHostMessage} from '@qwordly/core/bridge';
+import ${JSON.stringify(path.join(root,'src/styles.css'))};
+window.probe={sent:[],started:0,completed:0,closed:0,rejected:[],releases:[],errors:[],unhandled:[],owner:null};
