+
+} finally {
+  await browser?.close();
+  if (server) await new Promise(resolve => server.close(resolve));
+  await rm(scratch, {recursive: true, force: true});
+  await writeFile(path.join(evidence,'observations.json'),JSON.stringify(observations,null,2)+'\n');
