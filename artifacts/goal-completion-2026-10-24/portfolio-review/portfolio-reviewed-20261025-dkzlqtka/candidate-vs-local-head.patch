   }
 
diff --git a/src/server/blob-media-file.test.ts b/src/server/blob-media-file.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..463524325c67b200217d82367b215a03e45c8f5a
--- /dev/null
+++ b/src/server/blob-media-file.test.ts
@@ -0,0 +1,113 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { type GetBlobResult } from "@vercel/blob";
+
+import { loadBlobManagedMediaFile } from "./blob-media-file.ts";
+
+const image = new Uint8Array([82, 73, 70, 70, 1, 2, 3, 4]);
+
+function makeBlob(statusCode: 200 | 304): GetBlobResult {
+  const metadata = {
+    url: "https://example.public.blob.vercel-storage.com/uploads/image.webp",
+    downloadUrl:
+      "https://example.public.blob.vercel-storage.com/uploads/image.webp?download=1",
+    pathname: "uploads/image.webp",
+    contentDisposition: "inline",
+    cacheControl: "public, max-age=31536000, immutable",
+    uploadedAt: new Date("2026-10-24T00:00:00.000Z"),
+    etag: '"image-etag"',
+  };
+  if (statusCode === 304) {
+    return {
+      statusCode,
+      stream: null,
+      headers: new Headers(),
+      blob: { ...metadata, contentType: null, size: null },
+    };
+  }
+  return {
+    statusCode,
+    stream: new ReadableStream({
+      start(controller) {
+        controller.enqueue(image);
+        controller.close();
+      },
+    }),
+    headers: new Headers({ "x-provider-private-header": "not-forwarded" }),
+    blob: { ...metadata, contentType: "image/webp", size: image.byteLength },
+  };
+}
+
+test("Blob managed media streams a 200 image response without redirecting the optimizer", async () => {
+  const response = await loadBlobManagedMediaFile("uploads/image.webp", {
+    token: "example-private-token",
+    readBlob: async (pathname, options) => {
+      assert.equal(pathname, "uploads/image.webp");
+      assert.equal(options.access, "public");
+      assert.equal(options.token, "example-private-token");
+      return makeBlob(200);
+    },
+  });
+  assert.equal(response.status, 200);
+  assert.equal(response.headers.get("location"), null);
+  assert.equal(response.headers.get("content-type"), "image/webp");
+  assert.equal(
+    response.headers.get("content-length"),
+    String(image.byteLength),
+  );
+  assert.equal(response.headers.get("etag"), '"image-etag"');
+  assert.equal(response.headers.get("x-content-type-options"), "nosniff");
+  assert.equal(response.headers.get("x-provider-private-header"), null);
+  assert.equal(
+    response.headers.get("cache-control"),
+    "public, max-age=31536000, immutable",
+  );
+  assert.deepEqual(new Uint8Array(await response.arrayBuffer()), image);
+});
+
+test("Blob managed media preserves a provider not-modified response without a body", async () => {
+  const response = await loadBlobManagedMediaFile("uploads/image.webp", {
+    token: "example-private-token",
+    readBlob: async () => makeBlob(304),
+  });
+  assert.equal(response.status, 304);
+  assert.equal(response.headers.get("content-type"), null);
+  assert.equal(response.headers.get("content-length"), null);
+  assert.equal(response.headers.get("etag"), '"image-etag"');
+  assert.equal(await response.text(), "");
+});
+
