 import assert from "node:assert/strict";
 import test from "node:test";
+import { PassThrough } from "node:stream";
+import { createElement, Suspense } from "react";
+import { renderToPipeableStream } from "react-dom/server";
 
 import { filterServerSentryEvent } from "./sentry-server-filter.ts";
 
+const cancelledRenderEvent = {
+  contexts: {
+    nextjs: {
+      router_kind: "App Router",
+      route_type: "render",
+    },
+  },
+  exception: {
+    values: [
+      {
+        type: "Error",
+        value: "The destination stream closed early.",
+        mechanism: { type: "auto.function.nextjs.on_request_error" },
+      },
+    ],
+  },
+};
+
+test(
+  "drops the React error from a cancelled Next.js response stream",
+  { timeout: 5_000 },
+  async (t) => {
+    const pending = new Promise<never>(() => {});
+    function PendingContent(): never {
+      throw pending;
+    }
+
+    const destination = new PassThrough();
+    const error = await new Promise<unknown>((resolve, reject) => {
+      const stream = renderToPipeableStream(
+        createElement(
+          Suspense,
+          { fallback: "Loading" },
+          createElement(PendingContent),
+        ),
+        {
+          onShellReady() {
+            stream.pipe(destination);
+            destination.destroy();
+          },
+          onError: resolve,
+          onShellError: reject,
+        },
+      );
+      t.after(() => {
+        stream.abort();
+        destination.destroy();
+      });
+    });
+
+    assert.ok(error instanceof Error);
+    assert.equal(error.message, "The destination stream closed early.");
+    assert.equal(
+      filterServerSentryEvent({
+        ...cancelledRenderEvent,
+        exception: {
+          values: cancelledRenderEvent.exception.values.map((exception) => ({
+            ...exception,
+            type: error.name,
+            value: error.message,
+          })),
+        },
+      }),
+      null,
+    );
+  },
+);
+
+test("keeps stream failures without the Next.js render cancellation context", () => {
+  for (const nextjs of [
+    undefined,
+    null,
+    { router_kind: "App Router", route_type: "route" },
+    { router_kind: "App Router", route_type: "middleware" },
+    { router_kind: "Pages Router", route_type: "render" },
+  ]) {
+    const event = { ...cancelledRenderEvent, contexts: { nextjs } };
+    assert.deepEqual(filterServerSentryEvent(event), {
+      ...event,
+      user: undefined,
+      request: undefined,
+    });
+  }
+
+  for (const exception of [
+    { type: "Error", value: "The destination stream closed early." },
+    {
+      type: "Error",
+      value: "The destination stream closed early.",
+      mechanism: { type: "generic" },
+    },
+    {
+      type: "Error",
+      value: "The destination stream errored while writing data.",
+      mechanism: { type: "auto.function.nextjs.on_request_error" },
+    },
+    {
+      type: "Error",
+      value: "Database query failed",
+      mechanism: { type: "auto.function.nextjs.on_request_error" },
+    },
+  ]) {
+    const event = {
+      ...cancelledRenderEvent,
+      exception: { values: [exception] },
+    };
+    assert.deepEqual(filterServerSentryEvent(event), {
+      ...event,
+      user: undefined,
+      request: undefined,
+    });
+  }
+});
+
+test("keeps a cancellation with another exception in its cause chain", () => {
+  const event = {
+    ...cancelledRenderEvent,
+    exception: {
+      values: [
+        { type: "Error", value: "Database query failed" },
+        ...cancelledRenderEvent.exception.values,
+      ],
+    },
+  };
+  assert.deepEqual(filterServerSentryEvent(event), {
+    ...event,
+    user: undefined,
+    request: undefined,
+  });
+});
