+function isCancelledNextRender(event: SentryServerEvent) {
+  const nextjs = event.contexts?.nextjs;
+  const exceptions = event.exception?.values;
+
+  return (
+    isRecord(nextjs) &&
+    nextjs.router_kind === "App Router" &&
+    nextjs.route_type === "render" &&
+    exceptions?.length === 1 &&
+    exceptions[0]?.type === "Error" &&
+    exceptions[0].value === "The destination stream closed early." &&
+    exceptions[0].mechanism?.type === "auto.function.nextjs.on_request_error"
+  );
+}
