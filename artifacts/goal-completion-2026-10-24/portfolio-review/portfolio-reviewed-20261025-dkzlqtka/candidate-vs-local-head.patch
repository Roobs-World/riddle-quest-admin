+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { createIsolatedE2EEnvironment } from "./e2e-environment.mjs";
+import { resolveMediaStorageConfig } from "../src/server/media-storage-config.ts";
+
+for (const storageEnvironment of [
+  { BLOB_READ_WRITE_TOKEN: "vercel_blob_rw_remote-example" },
+  {
+    SUPABASE_URL: "https://remote-project.supabase.co",
+    SUPABASE_SECRET_KEY: "sb_secret_remote-example",
+    SUPABASE_STORAGE_BUCKET: "production-media",
+  },
+]) {
+  test(`E2E always uses local media with inherited ${Object.keys(storageEnvironment)[0]}`, () => {
+    const environment = createIsolatedE2EEnvironment(storageEnvironment);
+    assert.equal(resolveMediaStorageConfig(environment).backend, "local");
+    assert.equal(environment.BLOB_READ_WRITE_TOKEN, "");
+    assert.equal(environment.SUPABASE_SECRET_KEY, "");
+    assert.notDeepEqual(environment, storageEnvironment);
+  });
+}
+
+test("E2E disables inherited telemetry while retaining development authentication", () => {
+  const environment = createIsolatedE2EEnvironment({
+    CLERK_SECRET_KEY: "sk_test_example",
+    NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY: "pk_test_example",
+    NEXT_PUBLIC_SENTRY_DSN: "https://example.invalid/sentry",
+    SENTRY_DSN: "https://example.invalid/sentry",
+    SENTRY_AUTH_TOKEN: "example-token",
+    NEXT_PUBLIC_GA_MEASUREMENT_ID: "G-EXAMPLE",
+    REQUIRE_DURABLE_MEDIA_STORAGE: "1",
+    DATABASE_PROJECT_REF: "production-project",
+    CF_PAGES: "1",
+  });
+  assert.equal(environment.CLERK_SECRET_KEY, "sk_test_example");
+  assert.equal(
+    environment.NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY,
+    "pk_test_example",
+  );
+  for (const key of [
+    "NEXT_PUBLIC_SENTRY_DSN",
+    "SENTRY_DSN",
+    "SENTRY_AUTH_TOKEN",
+    "NEXT_PUBLIC_GA_MEASUREMENT_ID",
+    "REQUIRE_DURABLE_MEDIA_STORAGE",
+    "DATABASE_PROJECT_REF",
+    "CF_PAGES",
+  ]) {
+    assert.equal(environment[key], "", key);
+  }
+});
