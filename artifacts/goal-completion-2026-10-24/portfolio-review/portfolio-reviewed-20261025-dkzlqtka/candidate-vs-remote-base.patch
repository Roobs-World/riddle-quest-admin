--- /dev/null
+++ b/src/server/blob-media-file.ts
@@ -0,0 +1,36 @@
+import { get } from "@vercel/blob";
+
+export async function loadBlobManagedMediaFile(
+  pathname: string,
+  options: { token: string; readBlob?: typeof get },
+) {
+  try {
+    const blob = await (options.readBlob ?? get)(pathname, {
+      access: "public",
+      token: options.token,
+    });
+    if (blob) {
+      return new Response(blob.stream, {
+        status: blob.statusCode,
+        headers: {
+          "Cache-Control": blob.blob.cacheControl,
+          ETag: blob.blob.etag,
+          "X-Content-Type-Options": "nosniff",
+          ...(blob.statusCode === 200
+            ? {
+                "Content-Type": blob.blob.contentType,
+                "Content-Length": String(blob.blob.size),
+              }
+            : {}),
+        },
+      });
+    }
+  } catch {
+    // Missing and unavailable media retain the public route's generic response.
+  }
+
+  return new Response("Not found\n", {
+    status: 404,
+    headers: { "Cache-Control": "no-store" },
+  });
+}
