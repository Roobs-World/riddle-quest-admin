+import { execFile } from "node:child_process";
+import { mkdir, writeFile } from "node:fs/promises";
+import { createRequire } from "node:module";
+import path from "node:path";
+import { promisify } from "node:util";
+
+import { setupClerkTestingToken } from "@clerk/testing/playwright";
+import { z } from "zod";
+
+import { expect, test } from "@playwright/test";
+import { seedCookieConsent } from "./helpers";
+
+const require = createRequire(import.meta.url);
+const checkerJar = path.join(
+  path.dirname(require.resolve("vnu-jar")),
+  "build/dist/vnu.jar",
+);
+const run = promisify(execFile);
+const checkerReportSchema = z.object({
+  messages: z.array(
+    z.object({
+      type: z.string(),
+      url: z.string().optional(),
+      message: z.string(),
+      extract: z.string().optional(),
+    }),
+  ),
+});
+
+test("public HTML conforms before and after hydration", async ({
+  browser,
+  request,
+}, testInfo) => {
+  test.skip(
+    testInfo.project.name !== "desktop",
+    "HTML is viewport-independent.",
+  );
+  test.setTimeout(300_000);
+
+  const sitemap = await request.get("/sitemap.xml");
+  expect(sitemap.ok()).toBe(true);
+  const canonicalRoutes = Array.from(
+    (await sitemap.text()).matchAll(/<loc>([^<]+)<\/loc>/g),
+    (match) => new URL(match[1] ?? "").pathname,
+  );
+  expect(canonicalRoutes).toContain("/");
+  expect(canonicalRoutes).toContain("/blog");
+  expect(canonicalRoutes).toContain("/projects");
+
+  const routes = [...new Set([...canonicalRoutes, "/sign-in", "/sign-up"])];
+  const documentsDirectory = testInfo.outputPath("documents");
+  await mkdir(documentsDirectory, { recursive: true });
+  const context = await browser.newContext({ reducedMotion: "reduce" });
+  await setupClerkTestingToken({ context });
+  await seedCookieConsent(context);
+  const baseURL = new URL(sitemap.url()).origin;
+
+  try {
+    for (const [index, route] of routes.entries()) {
+      const page = await context.newPage();
+      try {
+        const response = await page.goto(`${baseURL}${route}`);
+        if (!response) throw new Error(`${route} did not return a document.`);
+        expect(response.status(), route).toBe(200);
+        await expect(page.getByRole("main")).toBeVisible();
+        await expect(page.getByRole("heading", { level: 1 })).toHaveCount(1);
+        // A pressed state confirms the shell's client effects have run.
+        await expect(
+          page.getByRole("button", { name: /Switch to .* mode/ }),
+        ).toHaveAttribute("aria-pressed", /true|false/);
+        if (route === "/sign-in" || route === "/sign-up") {
+          await expect(page.locator(".cl-form")).toBeVisible();
+        }
+
+        await writeFile(
+          path.join(documentsDirectory, `${index}-server.html`),
+          await response.text(),
+        );
+        await writeFile(
+          path.join(documentsDirectory, `${index}-hydrated.html`),
+          await page.content(),
+        );
+      } finally {
+        await page.close();
+      }
+    }
+  } finally {
+    await context.close();
+  }
+
+  const { stdout } = await run(
+    "java",
+    [
+      "-jar",
+      checkerJar,
+      "--stdout",
+      "--format",
+      "json",
+      "--exit-zero-always",
+      documentsDirectory,
+    ],
+    { maxBuffer: 16 * 1024 * 1024, timeout: 120_000 },
+  );
+  const report = checkerReportSchema.parse(JSON.parse(stdout));
+  await testInfo.attach("nu-html-report.json", {
+    body: stdout,
+    contentType: "application/json",
+  });
+  await testInfo.attach("routes.json", {
+    body: JSON.stringify(routes, null, 2),
+    contentType: "application/json",
+  });
+  const errors = report.messages.filter((message) => message.type !== "info");
+  expect(errors, JSON.stringify(errors, null, 2)).toEqual([]);
+});
