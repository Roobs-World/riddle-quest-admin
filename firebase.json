{
  "functions": {
    "source": "firebase-functions",
    "runtime": "nodejs22",
    "predeploy": [
      "pnpm --dir firebase-functions run prepare:deploy",
      "pnpm --dir firebase-functions run build"
    ]
  },
  "firestore": {
    "rules": "firebase-functions/firestore.rules",
    "indexes": "firebase-functions/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase-functions/storage.rules"
  },
  "hosting": {
    "public": "packages/portal/dist-jest",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "Cache-Control", "value": "no-store"},
          {"key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=()"},
          {"key": "Referrer-Policy", "value": "no-referrer"},
          {"key": "X-Content-Type-Options", "value": "nosniff"}
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|webp|svg|woff|woff2)",
        "headers": [
          {"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8099
    },
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
