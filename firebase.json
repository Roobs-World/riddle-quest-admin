{
  "functions": {
    "source": "firebase-functions",
    "runtime": "nodejs22",
    "predeploy": [
      "pnpm --dir firebase-functions run validate:deploy-env",
      "pnpm --dir firebase-functions run build"
    ],
    "ignore": [
      "node_modules",
      ".git",
      ".build-source",
      "coverage",
      "artifacts",
      "**/firebase-functions/content",
      "**/firebase-functions/config",
      "__tests__",
      "__mocks__",
      "scripts",
      "*.log",
      ".env*",
      "*.env",
      "*.runtimeconfig.json",
      "*admin-sdk*.json",
      "*.pem",
      "*.key",
      "**/src/**/*.ts",
      "**/src/**/*.md",
      "jest.*",
      "tsconfig*.json",
      "eslint.config.*",
      "firebase.*.json",
      "firestore.*",
      "database.*",
      "storage.rules",
      ".nvmrc",
      ".gitignore",
      ".gcloudignore"
    ]
  },
  "firestore": {
    "rules": "firebase-functions/firestore.rules",
    "indexes": "firebase-functions/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase-functions/storage.rules"
  },
  "database": {
    "rules": "firebase-functions/database.rules.json"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8099
    },
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    },
    "database": {
      "port": 9000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": false
  }
}
