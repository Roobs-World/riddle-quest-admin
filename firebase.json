{
  "functions": {
    "source": "firebase-functions",
    "runtime": "nodejs22",
    "predeploy": [
      "pnpm --dir firebase-functions run prepare:deploy"
    ]
  },
  "firestore": {
    "rules": "firebase-functions/firestore.rules"
  },
  "storage": {
    "rules": "firebase-functions/storage.rules"
  },
  "hosting": {
    "public": "packages/portal/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8099
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
