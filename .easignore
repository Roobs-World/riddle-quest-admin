# Ignore the node_modules directory as EAS installs dependencies
node_modules/

# Ignore native build output directories
/android/build/
/ios/build/

# Ignore version control history
.git/

# Ignore common cache and temporary directories
.expo/
.vscode/
*.iml
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.gradle/
.gradle-local/
.gradle-user/
!gradle-wrapper.jar # Include gradle wrapper jar for android builds
!gradlew # Include gradlew script for android builds
!gradlew.bat # Include gradlew.bat script for android builds

# Ignore potential metro cache
.metro/

# Ignore local environment variables if not managed via EAS Secrets
.env

firebase-functions
memory-bank
coverage
dist
.claude
.agents
.cursor

# You might want to add other large or unnecessary files/folders here
# For example, if you have a large assets folder used only for development
# assets/large-dev-only-assets/

/android
/ios 
