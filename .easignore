# Dependencies are installed by EAS from the lockfile.
node_modules/
.pnpm-store/

# Native projects and build output are generated during EAS prebuild.
android/
ios/
build/
dist/

# Local Gradle, Metro, Expo, and package-manager caches.
.gradle/
.gradle-local/
.gradle-user/
.kotlin/
.metro/
.metro-health-check*
.expo/
.eas-inspect-archive/
.expo-shared/
.npm/
.yarn/

# Version control, editor metadata, and agent/tooling state.
.git
.git/
.git/**
.github/
.vscode/
.idea/
.cursor/
.claude/
.agents/
*.iml
.DS_Store

# Local environment files should be provided by EAS env vars/secrets.
.env
.env.*
!.env.example

# Test, coverage, and debug output.
coverage/
emulator-tests/
test-results.json
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
*.hprof
*.trace
*.perfetto-trace
*.profraw
*.xcresult/

# Non-app workspace content.
docs/
memory-bank/
firebase-functions/

# Store and local build artifacts; these are already generated outputs.
releases/
web-build/
*.apk
*.aab
*.ipa
