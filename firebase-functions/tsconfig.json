{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "lib": ["esnext", "dom"],
    "types": ["node", "jest"],
    "forceConsistentCasingInFileNames": true
  },
  "compileOnSave": true,
  "include": ["src", "jest.config.js"],
  "exclude": ["node_modules", "node_modules/call-bind-apply-helpers", "**/*.bak", "**/*.skip"],
  "skipLibCheck": true
}
