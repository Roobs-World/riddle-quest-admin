{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": ".build-source",
    "sourceMap": true,
    "strict": true,
    "lib": [
      "esnext",
      "dom"
    ],
    "types": [
      "node",
      "jest"
    ],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "stableTypeOrdering": true,
    "noEmit": false
  },
  "compileOnSave": true,
  "include": [
    ".build-source/firebase-functions/src/**/*.ts",
    ".build-source/firebase-functions/src/**/*.js",
    ".build-source/platforms/**/server/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/*.bak",
    "**/*.skip"
  ]
}
