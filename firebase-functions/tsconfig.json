{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "paths": {
      "@qwordly/core": ["../packages/core/dist/index.d.ts"],
      "@qwordly/core/game": ["../packages/core/dist/game/index.d.ts"],
      "@qwordly/core/race": ["../packages/core/dist/race/index.d.ts"],
      "@qwordly/core/validation": ["../packages/core/dist/validation/index.d.ts"],
      "@qwordly/core/validation/*": ["../packages/core/dist/validation/*"]
    },
    "sourceMap": true,
    "strict": true,
    "lib": ["esnext", "dom"],
    "types": ["node", "jest"],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "stableTypeOrdering": true,
    "noEmit": false
  },
  "compileOnSave": true,
  "include": ["src/**/*.ts", "src/**/*.js", "jest.config.js"],
  "exclude": ["node_modules", "lib", "src/__tests__", "src/__mocks__", "**/*.bak", "**/*.skip"]
}
