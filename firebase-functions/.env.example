# Firebase Functions Environment Variables
# Copy this file to .env.riddle-quest-ec2b2 for a production deployment.
# DO NOT commit the .env file to version control

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
# OpenAI API key for riddle generation (REQUIRED)
OPENAI_API_KEY=your_openai_api_key_here
# Quality-first model used for both generation and independent riddle review.
# Riddle generation and review are pinned in code to gpt-6.1-sol.

# Optional backend telemetry. When set, the DSN must use HTTPS.
# SENTRY_DSN=https://public-key@example.ingest.sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=immutable-release-id

# =============================================================================
# JEST HTML5 PLATFORM CONFIGURATION
# =============================================================================
# Non-secret Jest Developer Console game ID and comma-separated production origins.
# Deployment validation rejects localhost and non-HTTPS origins.
JEST_GAME_ID=019faa68-f3ec-755d-9ab5-c887fb426801
JEST_GAME_ORIGIN=https://jest.com

# Optional defense-in-depth allowlist. Values must also exist in the trusted
# backend catalog; comma-separate the Jest product SKUs.
JEST_PRODUCT_SKUS=com.roobsworld.riddlequest.coinpack1,com.roobsworld.riddlequest.coinpack2,com.roobsworld.riddlequest.coinpack3,com.roobsworld.riddlequest.coinpack4,com.roobsworld.riddlequest.coinpack5,com.roobsworld.riddlequest.coinpack6

# Registered-only recurring subscription configured in the Jest Developer Console.
# Add the yearly SKU only after configuring that offer in the Jest Developer Console.
JEST_SUBSCRIPTION_SKUS=com.roobsworld.riddlequest.premium.monthly

# Authenticated HTML5 callables cannot present device attestation.

# JEST_SHARED_SECRET is deliberately absent here. Store the base64 value only
# with: firebase functions:secrets:set JEST_SHARED_SECRET

# =============================================================================
# FACEBOOK INSTANT GAMES CONFIGURATION
# =============================================================================
# Replace every placeholder before running preflight:facebook-backend. The
# numeric App ID comes from the Meta Developer app, not the Facebook Page.
FACEBOOK_APP_ID=replace_with_numeric_meta_app_id
FACEBOOK_FIREBASE_APP_ID=replace_with_firebase_web_app_id
FACEBOOK_GAME_ORIGINS=https://replace-with-meta-hosted-origin.example
FACEBOOK_DELETION_STATUS_BASE_URL=https://replace-with-deployed-deletion-status-url.example

# Facebook monetization uses Meta's payment and ad APIs.
# Leave empty for enabled features, or comma-separate emergency-off names from
# the operations runbook. Age, advertised SDK APIs and server gates still apply.
FACEBOOK_DISABLED_FEATURES=

# Enable only after an approved permission and accepted V2 callback subscription.
FACEBOOK_PAYMENTS_WEBHOOK_ENABLED=0
# Explicitly add DEV, DEV_EXTERNAL or TEST for an accepted sandbox rollout.
FACEBOOK_PAYMENT_ENVIRONMENTS=PROD

# FACEBOOK_APP_SECRET and FACEBOOK_UID_SECRET are deliberately absent. Create
# new values directly in Secret Manager; never paste either value into this file.

# =============================================================================
# REDDIT DEVVIT CONFIGURATION
# =============================================================================
REDDIT_APP_NAME=riddle-quest
REDDIT_FIREBASE_GATEWAY_HOST=us-central1-riddle-quest-ec2b2.cloudfunctions.net
REDDIT_DISABLED_FEATURES=
# Commerce and notifications remain disabled unless their external Reddit
# approvals are recorded and the exact capability is listed here.
REDDIT_APPROVED_FEATURES=
REDDIT_COMMERCE_SANDBOX_ENABLED=0

# REDDIT_GATEWAY_SECRET must be the same newly generated value in Firebase
# Secret Manager and the Devvit global secret setting. REDDIT_UID_SECRET must
# be an independent base64 32-byte key held only by Firebase. Neither belongs
# in this environment file or source control.

# Public Android registration used when issuing App Check tokens.
ANDROID_FIREBASE_APP_ID=1:329028367192:android:4c0af717dd9c0db1b7eb2d
