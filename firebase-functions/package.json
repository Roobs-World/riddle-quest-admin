{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts",
    "prebuild": "pnpm --dir .. --filter @qwordly/core build",
    "prepare:deploy": "node scripts/prepare-deploy.js",
    "build": "tsc -p tsconfig.json && rimraf lib/__tests__ lib/__mocks__",
    "pretest": "pnpm --dir .. --filter @qwordly/core build",
    "deploy": "firebase deploy --only functions",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" FIRESTORE_EMULATOR_HOST=127.0.0.1:8099 pnpm jest --config jest.config.js",
    "emulators:start": "firebase emulators:start --only firestore,auth --import=./.emulator-data --export-on-exit=./.emulator-data",
    "emulators:kill": "firebase emulators:exec --only firestore,auth \"echo 'Stopping emulators'\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "@qwordly/core": "file:./packages/core",
    "@sentry/node": "^10.54.0",
    "@types/express": "^4.17.25",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "googleapis": "^172.0.0",
    "openai": "^6.39.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@jest/globals": "^30.4.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.19",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "firebase": "^12.13.0",
    "firebase-functions-test": "^3.5.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "6.0.3",
    "vitest": "^4.1.7"
  },
  "private": true
}
