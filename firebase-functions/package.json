{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts src",
    "prebuild": "pnpm --dir .. --filter @qwordly/core build",
    "prepare:deploy": "node scripts/prepare-deploy.js",
    "build": "rimraf lib && tsc -p tsconfig.json && rimraf lib/__tests__ lib/__mocks__",
    "pretest": "pnpm --dir .. --filter @qwordly/core build",
    "deploy": "pnpm dlx firebase-tools deploy --only functions",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" FIRESTORE_EMULATOR_HOST=127.0.0.1:8099 pnpm jest --config jest.config.js",
    "emulators:start": "pnpm dlx firebase-tools emulators:start --only firestore,auth",
    "emulators:kill": "pnpm dlx firebase-tools emulators:exec --only firestore,auth \"echo 'Stopping emulators'\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@firebase/app": "0.15.0",
    "@firebase/app-compat": "0.5.14",
    "@qwordly/core": "file:./packages/core",
    "@sentry/node": "^10.62.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "openai": "^6.45.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.19",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "6.0.3"
  },
  "private": true
}
