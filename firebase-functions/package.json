{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts",
    "build": "tsc -p tsconfig.json && rimraf lib/__tests__ lib/__mocks__",
    "deploy": "firebase deploy --only functions",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" pnpm jest --config jest.config.js",
    "test:emulator": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8099 pnpm jest --config jest.config.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^4.0.0",
    "@types/express": "^4.17.22",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "in-app-purchase": "^1.11.4",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@jest/globals": "^29.7.0",
    "@types/in-app-purchase": "^1.11.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.50",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.31.0",
    "firebase": "^11.8.1",
    "firebase-functions-test": "^3.4.1",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3",
    "vitest": "^1.6.1"
  },
  "private": true
}
