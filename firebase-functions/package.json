{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts",
    "build": "tsc -p tsconfig.json && rimraf lib/__tests__ lib/__mocks__",
    "deploy": "firebase deploy --only functions",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" FIRESTORE_EMULATOR_HOST=127.0.0.1:8099 pnpm jest --config jest.config.js",
    "emulators:start": "firebase emulators:start --only firestore,auth --import=./.emulator-data --export-on-exit=./.emulator-data",
    "emulators:kill": "firebase emulators:exec --only firestore,auth \"echo 'Stopping emulators'\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^4.0.0",
    "@sentry/node": "^10.53.1",
    "@sentry/profiling-node": "^10.53.1",
    "@types/express": "^4.17.25",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "googleapis": "^171.4.0",
    "openai": "^4.104.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.41",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "firebase": "^12.13.0",
    "firebase-functions-test": "^3.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@sentry-internal/node-cpu-profiler",
      "esbuild",
      "protobufjs"
    ]
  }
}
