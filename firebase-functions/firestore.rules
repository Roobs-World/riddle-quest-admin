rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validation and security
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(userId) {
      return userId is string && userId.size() > 0 && userId == request.auth.uid;
    }

    // Check if the request is from a Firebase Cloud Function (admin SDK)
    function isServerRequest() {
      return request.auth.token.firebase.sign_in_provider == 'custom';
    }

    // Validate user document structure on creation/update
    // Uses request.resource.data (the incoming data) rather than resource.data
    // (the existing document, which is null for create operations).
    function isValidUserDocument() {
      let requiredFields = ['userId', 'username', 'email', 'coins'];
      let optionalFields = ['displayName', 'avatarUrl', 'hasPurchasedApp', 'createdAt', 'registeredAt', 'lastLogin', 'lastDailyChallengeCompletedAt', 'stats', 'progress', 'unlockedAchievements', 'fcmToken', 'fcmTokenUpdatedAt', 'lastStreakReminderSentAt'];
      let allFields = requiredFields.concat(optionalFields);

      return request.resource.data.keys().hasAll(requiredFields) &&
             request.resource.data.keys().hasOnly(allFields) &&
             request.resource.data.userId is string &&
             request.resource.data.username is string &&
             request.resource.data.username.size() >= 1 &&
             request.resource.data.username.size() <= 50 &&
             request.resource.data.email is string &&
             request.resource.data.email.matches('.*@.*\\..*') &&
             request.resource.data.coins is number &&
             request.resource.data.coins >= 0 &&
             (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100)) &&
             (!('avatarUrl' in request.resource.data) || (request.resource.data.avatarUrl is string)) &&
             (!('hasPurchasedApp' in request.resource.data) || request.resource.data.hasPurchasedApp is bool);
    }

    // Validate stats update structure
    function isValidStatsUpdate() {
      let allowedStats = ['xp', 'level', 'dailyPuzzlesCompleted', 'bestStreak', 'totalWordsGuessed', 'winRate', 'averageGuesses', 'totalScore', 'highestLevelClassic', 'gamesPlayed', 'wins', 'challengeWins', 'winStreak', 'totalWins', 'totalGuessesInWins', 'totalHintsUsed'];

      return request.resource.data.stats.keys().hasOnly(allowedStats) &&
             (!('xp' in request.resource.data.stats) || (request.resource.data.stats.xp is number && request.resource.data.stats.xp >= 0)) &&
             (!('level' in request.resource.data.stats) || (request.resource.data.stats.level is number && request.resource.data.stats.level >= 1)) &&
             (!('dailyPuzzlesCompleted' in request.resource.data.stats) || (request.resource.data.stats.dailyPuzzlesCompleted is number && request.resource.data.stats.dailyPuzzlesCompleted >= 0)) &&
             (!('bestStreak' in request.resource.data.stats) || (request.resource.data.stats.bestStreak is number && request.resource.data.stats.bestStreak >= 0)) &&
             (!('totalWordsGuessed' in request.resource.data.stats) || (request.resource.data.stats.totalWordsGuessed is number && request.resource.data.stats.totalWordsGuessed >= 0)) &&
             (!('winRate' in request.resource.data.stats) || (request.resource.data.stats.winRate is number && request.resource.data.stats.winRate >= 0 && request.resource.data.stats.winRate <= 100)) &&
             (!('totalScore' in request.resource.data.stats) || (request.resource.data.stats.totalScore is number && request.resource.data.stats.totalScore >= 0)) &&
             (!('gamesPlayed' in request.resource.data.stats) || (request.resource.data.stats.gamesPlayed is number && request.resource.data.stats.gamesPlayed >= 0));
    }

    // Validate progress update structure
    function isValidProgressUpdate() {
      let allowedProgress = ['classicIndex', 'dailyChallengeIndex', 'dailyChallengeCurrentQuestion', 'tutorialIndex'];

      return request.resource.data.progress.keys().hasOnly(allowedProgress) &&
             (!('classicIndex' in request.resource.data.progress) || (request.resource.data.progress.classicIndex is number && request.resource.data.progress.classicIndex >= 0)) &&
             (!('dailyChallengeIndex' in request.resource.data.progress) || (request.resource.data.progress.dailyChallengeIndex is number && request.resource.data.progress.dailyChallengeIndex >= 0)) &&
             (!('tutorialIndex' in request.resource.data.progress) || (request.resource.data.progress.tutorialIndex is number && request.resource.data.progress.tutorialIndex >= 0));
    }

    // Users collection - strict privacy controls
    match /users/{userId} {
      // Users can only read their own document
      allow read: if isOwner(userId);
      
      // Users can create their own document with proper validation
      allow create: if isOwner(userId) && 
                      isValidUser(userId) && 
                      isValidUserDocument();
      
      // Users can update their own document with validation
      // Server requests (Cloud Functions) can also update for game logic
      allow update: if (isOwner(userId) || isServerRequest()) && 
                      isValidUser(userId) && 
                      isValidUserDocument() &&
                      (!('stats' in request.resource.data) || isValidStatsUpdate()) &&
                      (!('progress' in request.resource.data) || isValidProgressUpdate());
      
      // Prevent client-side deletion - only allow server deletion
      allow delete: if isServerRequest();
    }

    // Riddles collection - read-only for clients, write-only for server
    match /riddles/{riddleId} {
      // Authenticated users can read riddles
      allow read: if isAuthenticated();
      
      // Only server (Cloud Functions) can create/update/delete riddles
      allow write: if isServerRequest();
    }

    // Daily riddles collection - read-only for clients, write-only for server
    match /dailyRiddles/{riddleId} {
      // Authenticated users (including anonymous guest accounts) can read daily riddles
      allow read: if isAuthenticated();

      // Only server (Cloud Functions) can create/update/delete daily riddles
      allow write: if isServerRequest();
    }

    // Daily Challenge singleton doc - read-only for clients
    match /dailyChallenge/current {
      // Authenticated users can read the current daily challenge
      allow read: if isAuthenticated();
      
      // Only server (Cloud Functions) can manage the current daily challenge
      allow write: if isServerRequest();
    }

    // User Classic Progress - strict user ownership
    match /userClassicProgress/{userRiddleId} {
      // Users can only read their own progress
      allow read: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid;
      
      // Users can create their own progress entries
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['userId', 'riddleId']) &&
                      request.resource.data.keys().hasOnly(['userId', 'riddleId', 'completed', 'attempts', 'completedAt']);
      
      // Users can update their own progress, server can also update
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || 
                      isServerRequest();
      
      // Only server can delete progress entries
      allow delete: if isServerRequest();
    }

    // User Daily Challenge Attempts - strict user ownership
    match /userDailyChallengeAttempts/{userChallengeDate} {
      // Users can only read their own attempts
      allow read: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid;
      
      // Users can create their own challenge attempts
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['userId', 'date']) &&
                      request.resource.data.keys().hasOnly(['userId', 'date', 'completed', 'attempts', 'completedAt']);
      
      // Users can update their own attempts, server can also update
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || 
                      isServerRequest();
      
      // Only server can delete challenge attempts
      allow delete: if isServerRequest();
    }

    // Processed Ad Callbacks - server-only subcollection for idempotency
    match /users/{userId}/processedAdCallbacks/{tokenId} {
      allow read: if isOwner(userId);
      allow write: if isServerRequest();
    }

    // Pending Ad Completions - server-only subcollection for rewarded ad queue
    match /users/{userId}/pendingAdCompletions/{docId} {
      allow read: if isOwner(userId);
      allow write: if isServerRequest();
    }

    // Processed Purchases - user subcollection for IAP tracking
    match /users/{userId}/processedPurchases/{purchaseToken} {
      // Users can read their own purchase history
      allow read: if isOwner(userId);
      
      // Only server can create/update purchase records
      allow write: if isServerRequest();
    }

    // Ad interaction tracking - server-only collection
    match /adInteractions/{interactionId} {
      // Only server can manage ad interactions
      allow read, write: if isServerRequest();
    }

    // Tutorial progress tracking - if it exists as a separate collection
    match /tutorialProgress/{userId} {
      // Users can read their own tutorial progress
      allow read: if isOwner(userId);
      
      // Users and server can update tutorial progress
      allow write: if isOwner(userId) || isServerRequest();
    }

    // App configuration - read-only for all authenticated users
    match /config/{configId} {
      // All authenticated users can read app configuration
      allow read: if isAuthenticated();
      
      // Only server can update configuration
      allow write: if isServerRequest();
    }

    // Product pricing catalog - readable by clients, writable by server only
    match /productPricing/{productId} {
      // Coin pack pricing is app catalog data; only authenticated users can read
      allow read: if isAuthenticated();

      // Only server can create/update/delete pricing documents
      allow write: if isServerRequest();
    }

    // Analytics collection - server-only
    match /analytics/{analyticsId} {
      // Only server can read/write analytics data
      allow read, write: if isServerRequest();
    }

    // Leaderboard collection - read for all authenticated users, write for server only
    match /leaderboard/{userId} {
      // Any authenticated user can read leaderboard entries
      allow read: if isAuthenticated();

      // Only Cloud Functions (admin SDK) may create or update entries
      allow write: if isServerRequest();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 
