rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validation and security
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin SDK requests bypass Firestore rules. Keeping this helper false
    // prevents clients from spoofing a privileged "server" request.
    function isServerRequest() {
      return false;
    }

    // Users collection - strict privacy controls
    match /users/{userId} {
      // Users can only read their own document
      allow read: if isOwner(userId);
      
      // User documents are created by Cloud Functions so initial coins,
      // progress, stats, and achievements cannot be forged by clients.
      allow create: if false;
      
      // Profile, entitlement, currency, progress, and notification fields are
      // updated only by validated Cloud Functions through the Admin SDK.
      allow update: if false;
      
      // Prevent client-side deletion - only allow server deletion
      allow delete: if false;
    }

    // Normalized username ownership is an internal serialization boundary.
    // Clients must not enumerate, claim, change, or release reservations.
    match /usernameReservations/{reservationId} {
      allow read, write: if false;
    }

    match /usernameReservationMigrations/{migrationId} {
      allow read, write: if false;
    }

    // Riddle answers are only returned through authoritative callable functions.
    match /riddles/{riddleId} {
      allow read, write: if false;
    }

    // Localized source content includes answers and must remain server-only.
    match /localizedRiddles/{locale}/riddles/{riddleId} {
      allow read, write: if false;
    }

    // Legacy daily source content also contains answers.
    match /dailyRiddles/{riddleId} {
      allow read, write: if false;
    }

    // User Classic Progress - strict user ownership
    match /userClassicProgress/{userRiddleId} {
      // Users can only read their own progress
      allow read: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid;
      
      allow create: if false;
      
      // Users can update their own progress, server can also update
      allow update: if false;
      
      allow delete: if false;
    }

    // User Daily Challenge Attempts - strict user ownership
    match /userDailyChallengeAttempts/{userChallengeDate} {
      // Users can only read their own attempts
      allow read: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid;
      
      allow create: if false;
      
      // Users can update their own attempts, server can also update
      allow update: if false;
      
      allow delete: if false;
    }

    // Tutorial progress tracking - if it exists as a separate collection
    match /tutorialProgress/{userId} {
      // Users can read their own tutorial progress
      allow read: if isOwner(userId);
      
      // Tutorial state is local UX state; clients do not need a database write.
      allow write: if false;
    }

    // App configuration - read-only for all authenticated users
    match /config/{configId} {
      // All authenticated users can read app configuration
      allow read: if isAuthenticated();
      
      // Only server can update configuration
      allow write: if isServerRequest();
    }

    // Product pricing catalog - readable by clients, writable by server only
    match /productPricing/{productId} {
      // Coin pack pricing is public app catalog data.
      allow read: if true;

      // Only server can create/update/delete pricing documents
      allow write: if isServerRequest();
    }

    // Analytics collection - server-only
    match /analytics/{analyticsId} {
      // Only server can read/write analytics data
      allow read, write: if isServerRequest();
    }

    // Leaderboard rows are exposed only through the authenticated callable,
    // which verifies a canonical row is still backed by a live user. Direct
    // reads could expose orphaned legacy identity snapshots.
    match /leaderboard/{userId} {
      allow read, write: if false;
    }

    // Race to 10 state is exclusively exposed through validated callable
    // functions. Answers, ghost timelines, attempts, and request receipts must
    // never be readable or writable through a client Firestore SDK.
    match /raceCategories/{categoryId} {
      allow read, write: if false;
    }

    match /raceDecks/{deckId} {
      allow read, write: if false;
    }

    match /raceRuns/{runId} {
      allow read, write: if false;

      match /requests/{requestId} {
        allow read, write: if false;
      }
    }

    match /raceChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /raceAttempts/{attemptId} {
      allow read, write: if false;
    }

    match /raceStartRequests/{requestId} {
      allow read, write: if false;
    }

    match /raceConfig/{configId} {
      allow read, write: if false;
    }

    match /raceAnalytics/{eventId} {
      allow read, write: if false;
    }

    match /users/{userId}/raceInbox/{itemId} {
      allow read, write: if false;
    }

    // Social relationships and moderation are callable-only. Direct reads
    // would reveal another player's actions; direct writes could forge trust.
    match /users/{userId}/knownRivals/{rivalId} {
      allow read, write: if false;
    }

    match /users/{userId}/blockedRivals/{rivalId} {
      allow read, write: if false;
    }

    match /socialModerationQueue/{reportId} {
      allow read, write: if false;
    }

    match /socialReportRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /facebookTournaments/{tournamentId} {
      allow read, write: if false;

      match /entries/{entryId} {
        allow read, write: if false;
      }
    }

    match /redditTournaments/{tournamentId} {
      allow read, write: if false;

      match /entries/{entryId} {
        allow read, write: if false;
      }
    }

    match /facebookContextCompetitions/{contextKey} {
      allow read, write: if false;

      match /entries/{entryId} {
        allow read, write: if false;
      }
    }

    match /facebookContextCompetitionHistory/{contextKey} {
      allow read, write: if false;
    }

    // Commerce balances, entitlements, and replay receipts are server-only.
    match /facebookCommerceAccounts/{userId} {
      allow read, write: if false;
    }

    match /facebookCommerceReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /facebookCommerceRefunds/{refundId} {
      allow read, write: if false;
    }

    match /redditCommerceAccounts/{userId} {
      allow read, write: if false;
    }

    match /redditCommerceReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /redditCommerceRefunds/{refundId} {
      allow read, write: if false;
    }

    // Cross-device notification prompt timing and acceptance are server-owned.
    match /facebookNotificationPromptLeases/{userId} {
      allow read, write: if false;
    }

    match /facebookReferralTokens/{tokenId} {
      allow read, write: if false;
    }

    match /facebookReferralBindings/{inviteeId} {
      allow read, write: if false;
    }

    match /facebookReferralDailyCaps/{capId} {
      allow read, write: if false;
    }

    match /facebookReferralSettlements/{settlementId} {
      allow read, write: if false;
    }

    match /redditReferralTokens/{tokenId} {
      allow read, write: if false;
    }

    match /redditReferralBindings/{inviteeId} {
      allow read, write: if false;
    }

    match /redditReferralDailyCaps/{capId} {
      allow read, write: if false;
    }

    match /redditReferralSettlements/{settlementId} {
      allow read, write: if false;
    }

    // Idempotency receipts prevent replaying game-completion rewards.
    match /gameCompletionReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 
