rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow authenticated users to read users collection, but only write to their own document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Prevent client-side deletion
    }

    // Allow authenticated users to read riddles collection
    // Writing is restricted, handled by server-side processes (e.g., Cloud Functions, Apps Script sync)
    match /riddles/{riddleId} {
      allow read: if request.auth != null;
      allow write: if false; // Prevent client-side writing
    }

    // Allow authenticated users to read and write their own classic progress
    match /userClassicProgress/{userRiddleId} {
       allow read: if request.auth != null && request.auth.uid == resource.data.userId;
       allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Allow authenticated users to read dailyChallenge collection
    // Writing is restricted, handled by server-side processes
    match /dailyChallenge/{date} {
      allow read: if request.auth != null;
      allow write: if false; // Prevent client-side writing
    }

    // Allow authenticated users to read and write their own daily challenge attempts
    match /userDailyChallengeAttempts/{userChallengeDate} {
       allow read: if request.auth != null && request.auth.uid == resource.data.userId;
       allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Deny all other read/write access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 