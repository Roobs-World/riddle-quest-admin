rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Files will likely be stored under a path like 'avatars/{userId}/{filename}'
    match /avatars/{userId}/{filename} {
      // Allow authenticated users to read any avatar
      allow read: if request.auth != null;

      // Allow an authenticated user to write (upload/update) only to their own directory
      // Ensure that the path segment matches the authenticated user's UID
      allow write: if request.auth != null && request.auth.uid == userId;

      // Prevent client-side deletion
      allow delete: if false;
    }

    // Deny all other read/write access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
} 