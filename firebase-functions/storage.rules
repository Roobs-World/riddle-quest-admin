rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions for validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidImageFile() {
      // Allow common image formats
      return request.resource != null &&
             request.resource.contentType != null && 
             (request.resource.contentType.matches('image/jpeg') ||
              request.resource.contentType.matches('image/png') ||
              request.resource.contentType.matches('image/webp'));
    }

    function isValidFileSize() {
      // Limit avatar images to 5MB
      return request.resource != null &&
             request.resource.size < 5 * 1024 * 1024;
    }

    function hasValidAvatarMetadata(userId) {
      return request.resource != null &&
             request.resource.metadata.ownerUid == userId &&
             request.resource.metadata.purpose == 'avatar';
    }

    function isValidFileName(filename) {
      // Ensure filename is reasonable (no path traversal, etc.)
      return filename.size() > 0 && 
             filename.size() <= 255 &&
             !filename.matches('.*\\.\\..*') &&  // No path traversal
             !filename.matches('.*/.*') &&       // No directory separators
             filename.matches('[a-zA-Z0-9._-]+'); // Only safe characters
    }

    // User avatar uploads
    match /avatars/{userId}/{filename} {
      // Anyone can read avatars (for displaying other users' avatars in game)
      allow read: if isAuthenticated();

      // Users can only upload to their own directory with validation
      allow create: if isOwner(userId) && 
                      isValidFileName(filename) &&
                      isValidImageFile() &&
                      isValidFileSize() &&
                      hasValidAvatarMetadata(userId);

      // Users can update their own avatars with same validation
      allow update: if isOwner(userId) && 
                      isValidFileName(filename) &&
                      isValidImageFile() &&
                      isValidFileSize() &&
                      hasValidAvatarMetadata(userId);

      // Users can delete their own avatars
      allow delete: if isOwner(userId);
    }

    // Temporary uploads directory (for processing before moving to final location)
    match /temp/{userId}/{filename} {
      // Users can upload to temp directory for processing
      allow create: if isOwner(userId) && 
                      isValidFileName(filename) &&
                      isValidImageFile() &&
                      isValidFileSize() &&
                      hasValidAvatarMetadata(userId);

      // Users can read their own temp files
      allow read: if isOwner(userId);

      // Auto-cleanup: files in temp should be processed quickly
      // Cloud Functions should move them to final location or delete them
      allow delete: if isOwner(userId);
    }

    // Game assets directory (read-only for users, managed by admin)
    match /assets/{allPaths=**} {
      // All authenticated users can read game assets
      allow read: if isAuthenticated();
      
      // Only admin/server can write game assets
      // In practice, this would be managed through Firebase Console or admin tools
      allow write: if false; // Disable writes from client
    }

    // User data exports (for GDPR compliance, etc.)
    match /exports/{userId}/{filename} {
      // Users can only read their own data exports
      allow read: if isOwner(userId);
      
      // Only server can create data exports
      allow write: if false; // Server handles via admin SDK
    }

    // Backup directory (admin/server only)
    match /backups/{allPaths=**} {
      // No client access to backups
      allow read, write: if false;
    }

    // Analytics and logs (server only)
    match /logs/{allPaths=**} {
      // No client access to logs
      allow read, write: if false;
    }

    // Rate limiting: Implicit through Firebase Storage quotas
    // Additional rate limiting should be implemented in Cloud Functions

    // Security: Virus scanning
    // Consider implementing virus scanning for uploaded files via Cloud Functions
    // triggered on file upload (finalize event)

    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
} 
