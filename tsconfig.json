{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "jsx": "react-native",
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "types": ["react", "react-native", "jest", "node", "@react-three/fiber"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@qwordly/core": ["packages/core/src/index.ts"],
      "@qwordly/core/*": ["packages/core/src/*"],
      "@assets/*": ["assets/*"],
      "@assets/3d/*": ["assets/3d/*"]
    }
  },
  "include": [
    "src/**/*",
    "src/types/**/*",
    "packages/core/src/**/*",
    "App.tsx",
    "global.css",
    "nativewind-env.d.ts",
    "global.d.ts"
  ],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.setup.js", "firebase-functions"]
}
