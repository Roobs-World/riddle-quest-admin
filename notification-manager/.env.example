# Supabase's Vercel integration supplies these automatically on connected environments.
# Only the URL and publishable key are bundled into the management website.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional public overrides for local development. Set both together, or leave both absent.
# VITE_NOTIFICATION_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_NOTIFICATION_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Vercel Functions only. Never prefix these with VITE_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
HOSTED_PUSH_VAPID_PUBLIC_KEY=
HOSTED_PUSH_VAPID_PRIVATE_KEY=
HOSTED_PUSH_VAPID_SUBJECT=mailto:YOUR_CONTACT_ADDRESS
CRON_SECRET=
NOTIFICATION_MANAGER_BRIDGE_SECRET=
ANDROID_NOTIFICATION_BRIDGE_URL=https://YOUR_REGION-YOUR_PROJECT.cloudfunctions.net/dispatchAndroidNotification
# Enable Facebook after the game dispatcher and its Meta app credential are configured.
FACEBOOK_NOTIFICATION_BRIDGE_URL=

# Shared public enrollment page. Firebase alone owns account-linked browser subscriptions.
NOTIFICATION_MANAGER_URL=https://YOUR_NOTIFICATION_MANAGER_ORIGIN
FIREBASE_NOTIFICATION_BRIDGE_URL=https://YOUR_REGION-YOUR_PROJECT.cloudfunctions.net/notificationBrowserBridge
# Enable only targets whose Firebase identity adapter and game handoff are configured.
FIREBASE_NOTIFICATION_TARGETS=[]

# Exact deployed browser game origins. Each platform has its own installation namespace.
NOTIFICATION_ALLOWED_ORIGINS={"yahoo":"https://YOUR_YAHOO_GAME_ORIGIN"}

# Optional local API development only. Never enable on a deployed environment.
NOTIFICATION_ALLOW_LOCALHOST=false

# Browser FCM enrollment gets its public Firebase settings from Firebase's authenticated
# configuration bridge. FCM service-account credentials and the Edge calling secret
# belong only in Supabase/Firebase server secrets, never Vercel public variables.
